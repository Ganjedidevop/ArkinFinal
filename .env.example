# GROQ_API_KEY: Required for Groq AI API calls (OpenAI-compatible chat completions).
# Configured securely via .env file or backend in production.
GROQ_API_KEY=MY_GROQ_API_KEY


# GOOGLE_WEB_CLIENT_ID: Optional Web Client ID for Google Sign-In with Credential Manager.
# Found in Firebase Console (arkin-22b82) -> Authentication -> Sign-in method -> Google -> Web SDK configuration.
GOOGLE_WEB_CLIENT_ID=""
